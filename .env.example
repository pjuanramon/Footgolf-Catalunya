# ============================================================
# Variables de entorno para el backend
# Liga Catalana de FootGolf
# ============================================================
# Copiar a .env y rellenar con valores reales.
# NUNCA subir .env a git.

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET_LICENCIAS=whsec_...
STRIPE_WEBHOOK_SECRET_INSCRIPCIONES=whsec_...

# --- Resend (Emails) ---
RESEND_API_KEY=re_...
EMAIL_FROM=Liga Catalana FootGolf <liga@footgolfcatalunya.com>

# --- App ---
APP_URL=https://footgolfcatalunya.com
ADMIN_SECRET=your-admin-secret-key
